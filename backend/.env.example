# ---- server ----
APP_NAME=missing-person-api
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Comma-separated origins, or * for local dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MongoDB (required at runtime) ----
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=missing_person_ai

# ---- auth ----
# CHANGE THIS in production. Never commit real secrets.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- uploads ----
STORAGE_DIR=./storage
MAX_IMAGE_BYTES=8388608

# ---- ORIGINAL AI artifacts (READ-ONLY roots; files are never written) ----
MPP_ORIGINAL_ROOT=C:/Users/shrut_hi39oyy/Downloads/mpp/mpp
# Optional explicit overrides (defaults resolve under MPP_ORIGINAL_ROOT):
# CNN_MODEL_PATH=
# CNN_KNN_PATH=
# CNN_LABELS_PATH=
# CNN_TRAIN_EMBEDDINGS_PATH=
# CNN_TRAIN_LABELS_PATH=
# ARCFACE_X_PATH=
# ARCFACE_Y_PATH=
# ARCFACE_MODEL_PATH=
# MEDIAPIPE_KNN_PATH=
# MEDIAPIPE_Y_PATH=
# MEDIAPIPE_TASK_PATH=
